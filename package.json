{
  "name": "erxes-ai-assistant-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Central Discord gateway for erxes Ai Assistant installations.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts",
    "register:commands": "tsx scripts/register-commands.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord-interactions": "^4.3.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.3"
}
